# =============================================================================
# Serve Search Service - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# --- General ---
SERVE_SEARCH_DEPLOYMENT_ENVIRONMENT=development
SERVE_SEARCH_SERVICE_VERSION=0.1.0
SERVE_SEARCH_RUNTIME_MODE=development
SERVE_SEARCH_LOG_DIRECTORY=logs

# --- Tenant ---
SERVE_SEARCH_TENANT_RESOLVER=development-header
SERVE_SEARCH_DEV_TENANT_ID=local-development-tenant

# --- Qdrant ---
SERVE_SEARCH_QDRANT_URL=http://localhost:6333
SERVE_SEARCH_QDRANT_API_KEY=
