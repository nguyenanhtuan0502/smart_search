# =============================================================================
# Serve Search Service - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# --- General ---
SERVE_SEARCH_DEPLOYMENT_ENVIRONMENT=development
SERVE_SEARCH_SERVICE_VERSION=0.1.0
SERVE_SEARCH_RUNTIME_MODE=development
SERVE_SEARCH_LOG_DIRECTORY=logs

# --- Tenant ---
SERVE_SEARCH_TENANT_RESOLVER=development-header
SERVE_SEARCH_DEV_TENANT_ID=local-development-tenant

# --- Qdrant ---
SERVE_SEARCH_QDRANT_URL=http://localhost:6333
SERVE_SEARCH_QDRANT_API_KEY=

# --- Dense Embedding Backend ---
SERVE_SEARCH_EMBEDDING_URL=http://10.6.14.127:9003
SERVE_SEARCH_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
SERVE_SEARCH_EMBEDDING_API_KEY=
SERVE_SEARCH_EMBEDDING_DIMENSIONS=2560
SERVE_SEARCH_EMBEDDING_TIMEOUT_SECONDS=60
SERVE_SEARCH_EMBEDDING_MAX_RETRIES=2
SERVE_SEARCH_EMBEDDING_RETRY_BACKOFF_SECONDS=1.5

# --- Sparse Embedding (BM25, computed in-process) ---
SERVE_SEARCH_SPARSE_EMBEDDING_MODEL=bm25
SERVE_SEARCH_SPARSE_EMBEDDING_K1=1.5
SERVE_SEARCH_SPARSE_EMBEDDING_B=0.75
SERVE_SEARCH_SPARSE_EMBEDDING_AVG_LEN=256.0

# --- Search / Rerank defaults (overridable per-request via search_options) ---
SERVE_SEARCH_DEFAULT_COLLECTION=EISO_COLLECTION
SERVE_SEARCH_DEFAULT_VECTOR_WEIGHT=0.7
SERVE_SEARCH_DEFAULT_KEYWORD_WEIGHT=0.3
SERVE_SEARCH_DEFAULT_RRF_K=5
SERVE_SEARCH_DEFAULT_CANDIDATE_MULTIPLIER=5
SERVE_SEARCH_DEFAULT_FUSION_MODE=client

# --- Router-regex dynamic routing (document-code / số-hiệu queries) ---
SERVE_SEARCH_DEFAULT_AUTO_ROUTE=true
SERVE_SEARCH_DEFAULT_IDENTIFIER_BONUS=0.5
# Leave empty to disable score filtering; set 0.0-1.0 to drop low-score docs.
SERVE_SEARCH_DEFAULT_SCORE_THRESHOLD=0.2

# --- Rerank defaults (overridable per-request via rerank option) ---
SERVE_SEARCH_DEFAULT_RERANK_STRATEGY=hybrid
SERVE_SEARCH_DEFAULT_RERANK_MEAN_M=3
SERVE_SEARCH_DEFAULT_RERANK_RRF_K=60
SERVE_SEARCH_DEFAULT_RERANK_TOP_CHUNKS=3

# --- Citation (highlighted snippets; overridable per-request via citation_options) ---
SERVE_SEARCH_DEFAULT_CITATION=true
SERVE_SEARCH_CITATION_IDF_TAU=2.5
SERVE_SEARCH_CITATION_TOP_KEYWORDS=6
SERVE_SEARCH_CITATION_MIN_COHESION=0.6
SERVE_SEARCH_CITATION_WINDOW_CHARS=400
SERVE_SEARCH_CITATION_COMPANION_RATIO=0.7
SERVE_SEARCH_CITATION_MAX_CHUNKS=5
SERVE_SEARCH_CITATION_SEMANTIC_GATE=0.5
SERVE_SEARCH_CITATION_MAX_PHRASE_TOKENS=6
SERVE_SEARCH_CITATION_NESTED_RATIO=0.9
# Also highlight other multi-syllable query words (IDF >= this) inside the snippet; >= IDF_TAU disables.
SERVE_SEARCH_CITATION_SECONDARY_TAU=1

